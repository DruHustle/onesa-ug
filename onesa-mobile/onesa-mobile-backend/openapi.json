{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Onesa Mobile prelaunch demonstration API",
    "version": "0.1.0",
    "description": "Public read-only fictional demonstration. There are no live accounts, carrier services, satellite entitlement or payments. A healthy process is not a production-ready telecom service. All JSON responses identify their demo/prelaunch status."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4000",
      "description": "Local development only"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check the process health, not telecom readiness",
        "description": "Read-only. No query parameters or request body are accepted. An unknown Origin is rejected. Responses are never cached.",
        "responses": {
          "200": {
            "description": "Check the process health, not telecom readiness",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "405": {
            "$ref": "#/components/responses/Error"
          },
          "414": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "head": {
        "operationId": "headHealth",
        "summary": "Read headers only",
        "responses": {
          "200": {
            "description": "No response body."
          },
          "400": {
            "description": "No response body."
          },
          "403": {
            "description": "No response body."
          }
        }
      },
      "options": {
        "operationId": "optionsHealth",
        "summary": "Restricted read-only CORS preflight",
        "description": "Exact configured origins only. Requested method must be GET or HEAD. Allowed request headers are Accept and Content-Type. Credentials are not enabled.",
        "responses": {
          "204": {
            "description": "No response body."
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "405": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
