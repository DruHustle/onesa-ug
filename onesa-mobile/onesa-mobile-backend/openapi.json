  "components": {
    "responses": {
      "Error": {
        "description": "Structured demonstration API error; submitted input is not echoed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "mode": {
            "const": "demo"
          },
          "serviceStatus": {
            "const": "prelaunch"
          },
          "status": {
            "const": "ok"
          },
          "service": {
            "const": "onesa-mobile-backend"
          },
          "productionReady": {
            "const": false
          }
        },
        "required": [
          "mode",
          "serviceStatus",
          "status",
          "service",
          "productionReady"
        ],
        "additionalProperties": false
      },
      "Plan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "everyday",
              "reach",
              "family-farm"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "null"
          },
          "allowance": {
            "type": "null"
          },
          "status": {
            "const": "proposed"
          },
          "activationAvailable": {
            "const": false
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "price",
          "allowance",
          "status",
          "activationAvailable",
          "features"
        ],
        "additionalProperties": false
      },
      "Catalog": {
        "type": "object",
        "properties": {
          "mode": {
            "const": "demo"
          },
          "serviceStatus": {
            "const": "prelaunch"
          },
          "disclaimer": {
            "type": "string"
          },
          "plans": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Plan"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "mode",
          "serviceStatus",
          "disclaimer",
          "plans"
        ],
        "additionalProperties": false
      },
      "PendingFeature": {
        "type": "object",
        "properties": {
          "available": {
            "const": false
          },
          "status": {
            "const": "provider_pending"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "available",
          "status",
          "detail"
        ],
        "additionalProperties": false
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "mode": {
            "const": "demo"
          },
          "serviceStatus": {
            "const": "prelaunch"
          },
          "productionReady": {
            "const": false
          },
          "enabledTransports": {
            "type": "array",
            "maxItems": 0
          },
          "features": {
            "type": "object",
            "properties": {
              "cellular": {
                "$ref": "#/components/schemas/PendingFeature"
              },
              "satellite": {
                "$ref": "#/components/schemas/PendingFeature"
              },
              "activation": {
                "$ref": "#/components/schemas/PendingFeature"
              },
              "payments": {
                "$ref": "#/components/schemas/PendingFeature"
              },
              "identity": {
                "$ref": "#/components/schemas/PendingFeature"
              }
            },
            "required": [
              "cellular",
              "satellite",
              "activation",
              "payments",
              "identity"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "mode",
          "serviceStatus",
          "productionReady",
          "enabledTransports",
          "features"
        ],
        "additionalProperties": false
      },
      "DemoAccount": {
        "type": "object",
        "properties": {
          "mode": {
            "const": "demo"
          },
          "serviceStatus": {
            "const": "prelaunch"
          },
          "fictional": {
            "const": true
          },
          "label": {
            "type": "string"
          },
          "account": {
            "type": "object",
            "properties": {
              "id": {
                "const": "demo-account"
              },
              "displayName": {
                "const": "Demo customer"
              },
              "selectedPlanId": {
                "const": "everyday"
              },
              "subscriptionStatus": {
                "const": "not_activated"
              }
            },
            "required": [
              "id",
              "displayName",
              "selectedPlanId",
              "subscriptionStatus"
            ],
            "additionalProperties": false
          },
          "usage": {
            "type": "object",
            "properties": {
              "usedGb": {
                "const": 2.4
              },
              "totalGb": {
                "const": 5
              },
              "source": {
                "const": "fictional_fixture"
              },
              "lastUpdated": {
                "type": "null"
              },
              "illustrationOnly": {
                "const": true
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "usedGb",
              "totalGb",
              "source",
              "lastUpdated",
              "illustrationOnly",
              "description"
            ],
            "additionalProperties": false
          },
          "activationAvailable": {
            "const": false
          },
          "paymentAvailable": {
            "const": false
          }
        },
        "required": [
          "mode",
          "serviceStatus",
          "fictional",
          "label",
          "account",
          "usage",
          "activationAvailable",
          "paymentAvailable"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "mode": {
            "const": "demo"
          },
          "serviceStatus": {
            "const": "prelaunch"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "SERVICE_NOT_READY",
                  "ORIGIN_NOT_ALLOWED",
                  "REQUEST_TARGET_TOO_LONG",
                  "INVALID_REQUEST_TARGET",
                  "METHOD_NOT_ALLOWED",
                  "NOT_FOUND",
                  "REQUEST_BODY_NOT_ALLOWED",
                  "HEADER_NOT_ALLOWED"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "mode",
          "serviceStatus",
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
